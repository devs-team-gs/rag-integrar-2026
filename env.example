# Plantilla de variables de entorno.
# Copiala a `.env` y completá GEMINI_API_KEY:   cp env.example .env

# Postgres (los lee docker-compose.yml)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev
POSTGRES_DB=rag
POSTGRES_PORT=5433

# Conexión de la app. El puerto es el del host: 5433, no 5432.
DATABASE_URL=postgresql://rag:rag_dev@localhost:5433/rag

# Sacala gratis en https://aistudio.google.com → Get API key → Create API key
GEMINI_API_KEY=

# Carpeta con los .md a indexar. Relativa a la raíz del proyecto.
APUNTES_DIR=./corpus
